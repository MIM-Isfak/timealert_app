# Root-level .gitignore for the time-alert-app monorepo
# Covers both backend/ and frontend/ subdirectories.

# Environment files (NEVER commit these — they contain secrets)
.env
.env.local
.env.production
.env.development.local
.env.test.local
.env.production.local

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.idea/
*.iml
.vscode/
*.suo
*.user

# Java build output
backend/target/
*.class
*.jar
*.war
*.ear

# Node
frontend/node_modules/
frontend/build/
frontend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Maven wrapper
!backend/mvnw
!backend/mvnw.cmd
!backend/.mvn/
