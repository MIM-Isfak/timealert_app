# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/timealert
DB_USERNAME=postgres
DB_PASSWORD=

# Server Configuration
PORT=8080
# Comma-separated list of allowed frontend origins (no spaces around commas, or trim is applied automatically)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security Configuration
# IMPORTANT: Replace this with a strong random secret (minimum 32 characters) before deploying!
# Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_BEFORE_DEPLOYING

# Mail Configuration (Gmail SMTP)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
# Web Push bridge (server only; same secret as notification-service INTERNAL_API_SECRET)
PUSH_SERVICE_URL=http://127.0.0.1:8787
PUSH_SERVICE_SECRET=

# Owner Bootstrap (comma-separated list of bootstrap owner email addresses)
# Example placeholder: OWNER_EMAILS=owner@example.com
OWNER_EMAILS=owner@example.com
