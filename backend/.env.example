# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/timealert
DB_USERNAME=postgres
DB_PASSWORD=

# Server Configuration
PORT=8080
# Comma-separated list of allowed frontend origins (no spaces around commas, or trim is applied automatically)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security Configuration
# IMPORTANT: Replace this with a strong random secret (minimum 32 characters) before deploying!
# Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_BEFORE_DEPLOYING

# Mail Configuration (Gmail SMTP)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=